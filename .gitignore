# VM images and snapshots (large binary files)
# images/ and traces/ are typically symlinks to a large-disk location;
# without the trailing slash the pattern ignores both directories and symlinks.
images/*
# ...but the boot launchers in there ARE source, and they now carry the
# SSH_PORT/TRIGGER/PIDFILE parameterisation that concurrent captures depend on.
!images/boot_build.sh
!images/boot_tcg_gate.sh
!images/boot_tcg_trace.sh
snapshots/*
!snapshots/README.md

# Raw and converted trace data
dump/*
!dump/README.md
traces

# Built binaries
plugin/champsim_tracer.so
plugin/trace_inspector
plugin/trace_filter
converter/raw2champsim

# Object files and compiled unit tests
*.o
converter/tests/decode_x86_test
converter/tests/decode_aarch64_test

# Generated by scripts/capture-kit/configure_tracer.sh
scripts/capture-kit/run_trace.sh
scripts/capture-kit/trace_metadata.txt

# Zydis (fetched by converter/Makefile)
converter/zydis/

# ChampSim build artifacts
champsim/obj/
champsim/bin/

# Editor / IDE
*.swp
*.swo
*~
.vscode/
.claude/
.idea/

# Staged per-instance data (fetched by stage_instance.py, not source)
__pycache__/
*.pyc

# Recorded cassettes and trajectories ARE tracked: they cost API credits and
# cannot be regenerated identically. The tarball is redundant with them.
artifacts/*/artifacts.tgz
